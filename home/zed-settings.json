{
  "auto_update": false,
  "base_keymap": "VSCode",
  "vim_mode": true,
  "theme": "Gruvbox Light Soft",
  "buffer_font_family": "HackGen Console NF",
  "buffer_font_size": 20,
  "git_commit_buffer_font_size": 18,
  "ui_font_size": 18,
  "line_indicator_format": "short",
  "status_bar": {
    "active_language_button": true,
    "cursor_position_button": true
  },
  "format_on_save": "on",
  "soft_wrap": "none",
  "restore_on_startup": "launchpad",
  "disable_ai": true,
  "features": {
    "edit_predictions": {
      "provider": "none"
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "gutter": {
    "folds": false
  },
  "minimap": {
    "show": "never"
  },
  "sticky_scroll": {
    "enabled": false
  },
  "terminal": {
    "button": true,
    "font_family": "HackGen Console NF",
    "font_size": 16,
    "line_height": "standard",
    "shell": {
      "program": "zsh"
    }
  },
  "languages": {
    "C": {
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "C++": {
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "LaTeX": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "tex-fmt",
          "arguments": ["--stdin"]
        }
      }
    },
    "Nix": {
      "language_servers": ["nixd", "!nil"],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "nixfmt",
          "arguments": []
        }
      }
    },
    "Python": {
      "language_servers": ["pyright", "ruff", "!basedpyright"],
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      },
      "use_on_type_format": true
    },
    "Rust": {
      "format_on_save": "on",
      "formatter": "language_server"
    }
  },
  "lsp": {
    "clangd": {
      "binary": {
        "arguments": [
          "--background-index",
          "--clang-tidy",
          "--completion-style=detailed"
        ]
      }
    },
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "executable": "latexmk",
            "args": [
              "-verbose",
              "-file-line-error",
              "-synctex=1",
              "-interaction=nonstopmode",
              "-aux-directory=.aux",
              "-output-directory=.out",
              "%f"
            ],
            "onSave": true,
            "auxDirectory": ".aux",
            "logDirectory": ".aux",
            "pdfDirectory": ".out"
          }
        }
      }
    }
  }
}
