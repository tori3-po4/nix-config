{
  "auto_update": false,
  "base_keymap": "VSCode",
  "vim_mode": true,
  "theme": "Gruvbox Light Soft",
  "buffer_font_family": "HackGen Console NF",
  "buffer_font_size": 16,
  "git_commit_buffer_font_size": 16,
  "ui_font_size": 16,
  "format_on_save": "on",
  "soft_wrap": "none",
  "restore_on_startup": "launchpad",
  "disable_ai": false,
  "show_edit_predictions": true,
  "show_completions_on_input": true,
  "edit_predictions": {
    "provider": "open_ai_compatible_api",
    "mode": "eager",
    "open_ai_compatible_api": {
      "api_url": "http://127.0.0.1:18080/v1/completions",
      "model": "qwen2.5-coder-1.5b-base",
      "prompt_format": "qwen",
      "max_output_tokens": 64
    }
  },
  "profiles": {
    "Local Qwen (AI on)": {
      "settings": {
        "disable_ai": false,
        "show_edit_predictions": true,
        "edit_predictions": {
          "provider": "open_ai_compatible_api"
        }
      }
    },
    "AtCoder (AI off)": {
      "settings": {
        "disable_ai": true,
        "show_edit_predictions": false,
        "edit_predictions": {
          "provider": "none"
        }
      }
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "gutter": {
    "folds": false
  },
  "minimap": {
    "show": "never"
  },
  "sticky_scroll": {
    "enabled": false
  },
  "terminal": {
    "font_family": "HackGen Console NF",
    "font_size": 16,
    "shell": {
      "program": "zsh"
    }
  },
  "languages": {
    "C": {
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "C++": {
      "completions": {
        "lsp": true,
        "words": "enabled"
      },
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "LaTeX": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "tex-fmt",
          "arguments": ["--stdin"]
        }
      }
    },
    "Nix": {
      "language_servers": ["nixd", "!nil"],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "nixfmt",
          "arguments": []
        }
      }
    },
    "Python": {
      "language_servers": ["pyright", "ruff", "!basedpyright"],
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      },
      "use_on_type_format": true
    },
    "Rust": {
      "format_on_save": "on",
      "formatter": "language_server"
    }
  },
  "lsp": {
    "clangd": {
      "binary": {
        "arguments": [
          "--background-index",
          "--clang-tidy",
          "--completion-style=detailed",
          "--completion-parse=always",
          "--limit-results=300"
        ]
      }
    },
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "executable": "latexmk",
            "args": [
              "-verbose",
              "-file-line-error",
              "-synctex=1",
              "-interaction=nonstopmode",
              "-aux-directory=.aux",
              "-output-directory=.out",
              "%f"
            ],
            "onSave": true,
            "auxDirectory": ".aux",
            "logDirectory": ".aux",
            "pdfDirectory": ".out"
          }
        }
      }
    }
  }
}
