# Ports exposed on 127.0.0.1
SEARXNG_PORT=8888
CRAWL4AI_PORT=11235

# Crawl4AI local-only defaults.
CRAWL4AI_IMAGE=unclecode/crawl4ai:latest
CRAWL4AI_SHM_SIZE=1g
CRAWL4AI_MEMORY_LIMIT=3g
CRAWL4AI_API_TOKEN=local-only-crawl4ai-change-me
CRAWL4AI_HOOKS_ENABLED=false
CRAWL4AI_LOG_LEVEL=INFO
CRAWL4AI_REDIS_TASK_TTL=3600
