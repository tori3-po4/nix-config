# Ports exposed on 127.0.0.1
FIRECRAWL_PORT=3002

# Firecrawl local-only defaults
BULL_AUTH_KEY=local-only-change-me
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Keep local laptop resource use lower than the upstream defaults.
NUQ_WORKER_COUNT=1
NUM_WORKERS_PER_QUEUE=4
CRAWL_CONCURRENT_REQUESTS=6
MAX_CONCURRENT_JOBS=3
BROWSER_POOL_SIZE=3
LOGGING_LEVEL=INFO

# Optional proxy knobs for Firecrawl/Playwright.
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
ALLOW_LOCAL_WEBHOOKS=false
BLOCK_MEDIA=

# Optional Firecrawl search tuning. Hermes searches SearXNG directly, but
# Firecrawl also receives SEARXNG_ENDPOINT inside docker-compose.yml.
SEARXNG_ENGINES=
SEARXNG_CATEGORIES=
